# ---------------------------------------------------------------------------
# Browser-visible build-time configuration
#
# Inlined into the static bundle by Next.js. Nothing prefixed NEXT_PUBLIC_ is a
# secret — treat every value here as published. Authorization is enforced by
# Convex functions, never by keeping these hidden.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_APP_URL=https://chrisnkuno.github.io/firstcontact
# Set to "/<repo-name>" for a GitHub Pages project site served from a subpath.
# Leave empty for a user/organization site or a custom domain.
NEXT_PUBLIC_BASE_PATH=/firstcontact

# ---------------------------------------------------------------------------
# Convex deployment environment
#
# Set with `bunx convex env set <NAME>`, NOT in this file — the app is a static
# export with no server, so these exist only inside Convex.
# ---------------------------------------------------------------------------

# Origins allowed to POST to the public ingestion endpoints. Must include the
# deployed site origin or every signup is rejected as cross-origin.
# SITE_ORIGIN=https://chrisnkuno.github.io
# SITE_ORIGIN_ALTERNATE=http://localhost:3000

# HMAC key for rate-limiter keys, so the limiter table never stores raw IPs.
# Public write endpoints fail closed without it.
# RATE_LIMIT_SECRET=

# One-time bootstrap for the first admin account. Stops working permanently
# once any admin exists; rotate or remove it afterwards.
# ADMIN_BOOTSTRAP_SECRET=

# Providers. Each integration reports itself as unconfigured rather than
# fabricating output when its key is absent.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano
# EXA_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM=
# RESEND_WEBHOOK_SECRET=

# Outbound delivery gates. Every one of these must be satisfied before a
# message can leave; see lib/compliance.ts and docs/COMPLIANCE.md.
# OUTBOUND_EMAIL_ENABLED=false
# SENDER_POSTAL_ADDRESS=
# JURISDICTION_REVIEWED=false

# Shared secret between Convex and the FastAPI workflow service.
# WORKFLOW_ACTION_SECRET=

# ---------------------------------------------------------------------------
# FastAPI workflow service (services/api) — deployed separately
# ---------------------------------------------------------------------------
# CONVEX_URL=https://your-deployment.convex.cloud
# WORKFLOW_ACTION_SECRET=
# FASTAPI_SERVICE_TOKEN=
# EXECUTION_MODE=disabled
# E2B_API_KEY=
# E2B_TEMPLATE=
# WORKER_GATEWAY_URL=
# EXA_API_KEY=
