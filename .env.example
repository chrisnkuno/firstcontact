# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex (created by `bunx convex dev`)
CONVEX_DEPLOYMENT=
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
SIGNUP_INGEST_SECRET=

# FastAPI workflow backend. All values are server-side only.
WORKFLOW_ACTION_SECRET=
FASTAPI_SERVICE_TOKEN=
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
EXECUTION_MODE=disabled
E2B_API_KEY=
E2B_TEMPLATE=base
E2B_TEMPLATE_VERSION=firstcontact-python-v1
E2B_WORKER_VERSION=0.1.0
E2B_TIMEOUT_SECONDS=180
WORKFLOW_LEASE_SECONDS=300
DISPATCHER_POLL_SECONDS=2
DISPATCHER_ID=firstcontact-fastapi
WORKER_GATEWAY_URL=
EXA_TIMEOUT_SECONDS=30

# Provider credentials — server-side only
EXA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
RESEND_API_KEY=
RESEND_FROM=FirstContact <introductions@yourdomain.org>
RESEND_WEBHOOK_SECRET=

# Safety: live outbound is off unless explicitly enabled.
OUTBOUND_EMAIL_ENABLED=false
OUTBOUND_API_TOKEN=
OUTBOUND_DAILY_LIMIT=25
DATA_RETENTION_DAYS=180

# Techadmin auth (see "Techadmin access" in the README). Set the same values
# with `bunx convex env set ADMIN_BOOTSTRAP_SECRET` / `... ADMIN_ACTION_SECRET`
# on the Convex deployment before running scripts/create-admin.mjs.
ADMIN_BOOTSTRAP_SECRET=
ADMIN_ACTION_SECRET=

# Participant status auth (see "Participant status access" in the README).
# Set the same value with `bunx convex env set FOUNDER_ACTION_SECRET` on the
# Convex deployment before running scripts/create-founder-account.mjs.
FOUNDER_ACTION_SECRET=
